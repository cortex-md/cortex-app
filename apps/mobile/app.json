{
	"expo": {
		"name": "Cortex",
		"slug": "Cortex",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "cortex",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "app.cortex.mobile",
			"infoPlist": {
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				},
				"NSLocalNetworkUsageDescription": "Cortex connects to the sync server you run on your local network."
			}
		},
		"android": {
			"package": "app.cortex.mobile",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-status-bar",
			"expo-web-browser",
			"expo-sqlite",
			"expo-sharing",
			[
				"expo-image-picker",
				{
					"photosPermission": "Cortex inserts the photos you choose into your notes.",
					"cameraPermission": "Cortex inserts the photos you take into your notes."
				}
			],
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "16.4"
					},
					"android": {
						"minSdkVersion": 24
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
