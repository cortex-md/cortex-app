{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"strict": true,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@/assets/*": [
				"./assets/*"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts"
	],
	"references": [
		{
			"path": "../../packages/plugin-api"
		},
		{
			"path": "../../packages/commands"
		},
		{
			"path": "../../packages/core"
		},
		{
			"path": "../../packages/editor"
		},
		{
			"path": "../../packages/hotkeys"
		},
		{
			"path": "../../packages/platform"
		},
		{
			"path": "../../packages/plugin-host-core"
		},
		{
			"path": "../../plugins"
		},
		{
			"path": "../../packages/properties"
		},
		{
			"path": "../../packages/renderer"
		},
		{
			"path": "../../packages/settings"
		},
		{
			"path": "../../packages/sync-api"
		},
		{
			"path": "../../packages/theme"
		},
		{
			"path": "../../packages/import-export"
		},
		{
			"path": "../../packages/templates"
		},
		{
			"path": "../../packages/search"
		},
		{
			"path": "../../packages/tasks"
		}
	]
}
