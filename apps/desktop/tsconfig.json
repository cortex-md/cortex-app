{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": false,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "electron/contract.ts"],
	"references": [
		{
			"path": "../../packages/collab"
		},
		{
			"path": "../../packages/commands"
		},
		{
			"path": "../../packages/comments"
		},
		{
			"path": "../../packages/theme"
		},
		{
			"path": "../../packages/core"
		},
		{
			"path": "../../packages/editor"
		},
		{
			"path": "../../packages/plugin-api"
		},
		{
			"path": "../../packages/plugin-host-core"
		},
		{
			"path": "../../packages/renderer"
		},
		{
			"path": "../../packages/platform"
		},
		{
			"path": "../../packages/properties"
		},
		{
			"path": "../../packages/tasks"
		},
		{
			"path": "../../packages/marketplace"
		},
		{
			"path": "../../packages/settings"
		},
		{
			"path": "../../packages/ui"
		},
		{
			"path": "../../packages/search"
		},
		{
			"path": "../../plugins"
		}
	]
}
