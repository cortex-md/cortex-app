{
	"name": "cortex",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.3",
	"workspaces": [
		"apps/*",
		"packages/*",
		"plugins",
		"tools/*"
	],
	"scripts": {
		"build": "bun run --cwd apps/desktop build",
		"build:web": "bun run --cwd apps/web build",
		"dev:desktop": "bun run --cwd apps/desktop dev",
		"dev:mobile": "bun run --cwd apps/mobile start",
		"dev:web": "bun run --cwd apps/web dev",
		"dist:desktop": "bun run --cwd apps/desktop dist",
		"check": "biome check apps/desktop packages plugins scripts tools package.json biome.json tsconfig.json tsconfig.base.json vitest.config.ts",
		"check:fix": "biome check --write apps/desktop packages plugins scripts tools package.json biome.json tsconfig.json tsconfig.base.json vitest.config.ts",
		"check:boundaries": "bun run scripts/check-workspace-boundaries.ts",
		"check:mobile": "bun run --cwd apps/mobile check",
		"check:web": "bun run --cwd apps/web check",
		"typecheck": "tsc -b apps/desktop apps/desktop/tsconfig.electron.json apps/desktop/tsconfig.node.json plugins && tsc -p tools/benchmarks",
		"typecheck:all": "tsc -b",
		"typecheck:mobile": "bun run --cwd apps/mobile typecheck",
		"typecheck:web": "bun run --cwd apps/web typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mobile": "bun run --cwd apps/mobile test",
		"test:web": "bun run --cwd apps/web test",
		"bench": "bun run --cwd tools/benchmarks bench",
		"bench:large-vault": "bun run --cwd tools/benchmarks large-vault",
		"perf": "bun run --cwd tools/benchmarks app",
		"perf:monitor": "bun run --cwd tools/benchmarks monitor",
		"doctor": "bunx react-doctor@0.9.17 apps/desktop --verbose --scope changed",
		"doctor:full": "bunx react-doctor@0.9.17 apps/desktop --verbose",
		"doctor:mobile": "bun run --cwd apps/mobile doctor"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.4",
		"jsdom": "^30.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@testing-library/dom": "^10.4.2"
	},
	"trustedDependencies": [
		"electron"
	],
	"overrides": {
		"dompurify": "3.4.17",
		"katex": "0.17.0",
		"undici": "7.28.0",
		"yjs": "13.6.33",
		"react-native-screens": "4.26.2"
	}
}
