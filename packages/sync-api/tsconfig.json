{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"types": []
	},
	"include": ["src"],
	"references": [{ "path": "../platform" }]
}
